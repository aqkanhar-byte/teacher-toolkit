# Copy this file to .env and fill in real values. Never commit .env — it's already gitignored.

# Anthropic Claude API key (console.anthropic.com) — powers every AI generation route.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local dev port. Render/hosting platforms inject their own PORT — leave this for local use only.
PORT=3000

# Supabase project (Settings → API). SUPABASE_SERVICE_KEY is the SERVICE ROLE key, not the anon
# key — it bypasses row-level security, so it must only ever live server-side, never in a client.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password required for every /admin/* API route and the admin.html login screen. Pick something
# strong — this single password gates credit management, subscription cancellation, and the
# Book Bank upload pipeline.
ADMIN_PASSWORD=change-me-to-something-strong

# Displayed on the pricing/payment screen so teachers know where to send Easypaisa payment.
EASYPAISA_NUMBER=03xxxxxxxxx
EASYPAISA_NAME=Your Name

# WhatsApp number teachers are told to message after paying, so an admin can manually credit them.
WHATSAPP_NUMBER=03xxxxxxxxx
